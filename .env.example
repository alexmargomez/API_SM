# ==========================================
# Variables de Entorno - API_SM (Docker Compose)
# ==========================================

# Puertos Expuestos
BACKEND_PORT=8000
FRONTEND_PORT=5174
DB_EXTERNAL_PORT=3307

# Claves de Django (Backend)
SECRET_KEY=poner_aqui_clave_secreta_django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,tu_ip_o_dominio
CSRF_TRUSTED_ORIGINS=http://localhost,https://localhost,http://localhost:5173,http://tu_dominio,https://tu_dominio

# Claves de Base de Datos (MariaDB)
MYSQL_DATABASE=api_sm_db
MYSQL_USER=api_user
MYSQL_PASSWORD=api_password
MYSQL_ROOT_PASSWORD=api_root_password

DB_NAME=api_sm_db
DB_USER=api_user
DB_PASSWORD=api_password
DB_HOST=db
DB_PORT=3306

# Frontend (Vue 3 + Vite)
VITE_API_URL=/api
VITE_BACKEND_PROXY=http://backend:8000
